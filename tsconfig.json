{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "prisma/**/*.ts",
    "src/app/(dashboard)/(with-sidebar)/layout.2",
    "src/lib/axios2.ant",
    "src/components/auth/ResetPasswordForm.borrar",
    "src/app/forgot-password/page.borrar",
    "src/app/no-autorizado/page.borrar",
    "src/app/api/users/[id]/legajo/route.back",
    "src/app/(dashboard)/receipts/page.ant",
    "src/app/(dashboard)/users/import/page.ant"
, "src/features/partidos/components/plantel-columns.tsx", "src/features/partidos/components/PlantelList.tsxsrc/features/partidos/components/PlantelManager.tsxer.2"  ],
  "exclude": ["node_modules"]
}